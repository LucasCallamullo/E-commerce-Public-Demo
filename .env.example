# ------------------ EXTERNAL KEYS
# Mercado Pago (Sandbox)
MERCADO_PAGO_PUBLIC_KEY='pk_test_...'
MERCADO_PAGO_ACCESS_TOKEN='at_test_...'

# Email SMTP (for sending emails)
EMAIL_HOST_USER='your_email@gmail.com'
EMAIL_HOST_PASSWORD='your_app_password'

# External Image Service (Optional - not currently used)
# IMG_BB_KEY='your_api_key'

# ------------------ DJANGO SETTINGS
SECRET_KEY='your-secret-key-here'
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,web_client_1,*.ngrok-free.app

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.ngrok-free.app

# Base URL for the application
BASE_URL_PAGE=http://localhost:8000

# Django settings module
DJANGO_SETTINGS_MODULE=ecommerce.settings

# ------------------ DATABASE (PostgreSQL)
# Must match the docker-compose service name
DB_NAME=ecommerce_db
DB_USER=db_user
DB_PASSWORD=your_db_password
DB_HOST=db_service_name
DB_PORT=5432